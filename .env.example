# Copy to .env and fill in. Never commit .env.
# Variables prefixed VITE_ are baked into the frontend at BUILD time and are PUBLIC.

# ---- App ----
NODE_ENV=development
PORT=8080
APP_NAME=My App
# Public URL of the site. Used in email links. Local dev: the Vite URL. Production: your Render URL.
APP_URL=http://localhost:5173
# Only needed if the frontend is hosted on a different origin than the API (comma-separated).
CORS_ORIGINS=
# report-only logs CSP problems; enforce blocks them. Switch once everything works in production.
CSP_MODE=report-only

# ---- Database (Neon) ----
# Neon dashboard -> Connect -> copy the connection string (keep ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Apply schema.sql automatically when the server starts (safe to re-run).
AUTO_MIGRATE=true

# ---- Auth ----
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Seed (npm run seed) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Admin

# ---- Cloudinary (image uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=my-app

# ---- Resend (emails) ----
# Without a key, emails are printed to the server console instead (handy for local dev).
RESEND_API_KEY=
# Must be a verified domain in Resend. For testing: My App <onboarding@resend.dev>
EMAIL_FROM=My App <onboarding@resend.dev>

# ---- Paystack (optional; see README to remove) ----
# Public key: used in the browser. Secret key: server only, never prefix with VITE_.
VITE_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=GHS

# ---- Frontend (optional) ----
VITE_APP_NAME=My App
