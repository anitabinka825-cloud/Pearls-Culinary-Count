# Pearls Culinary Counts — Environment Configuration
# -----------------------------------------------------------------------------
# Environment configuration (Firebase auth, API server, Paystack, Sailup, security):
# This project operates as a full-featured web application with Stage 3 Firebase
# Authentication integration. Public product catalogue browsing is fully active,
# and customer authentication requires Firebase credentials.
# -----------------------------------------------------------------------------

# APP_URL: The public URL where this web application is hosted.
APP_URL=

# -----------------------------------------------------------------------------
# Firebase Authentication Configuration (Stage 3)
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# Backend (Express + PostgreSQL) — server/
# -----------------------------------------------------------------------------
PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/pearls
# Set to true for managed Postgres that requires SSL (e.g. Render external URL)
DATABASE_SSL=false
# Comma-separated emails that receive the admin role when they sign in.
ADMIN_EMAILS=
# Firebase Admin (verifies customer sign-in tokens). Paste the service-account JSON on one line.
# If omitted, only the project id from VITE_FIREBASE_PROJECT_ID is used (enough for verifyIdToken).
FIREBASE_SERVICE_ACCOUNT_JSON=
# Only needed if the frontend is served from a different origin than the API.
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Paystack (Stage 6) — SERVER-SIDE ONLY. Never prefix with VITE_ and never commit real keys.
# Use your TEST secret key (sk_test_…) until you are ready to go live.
# -----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
# Which payment options checkout shows: "mobile_money,card" (default) or "all" to show every channel enabled on your account.
PAYSTACK_CHANNELS=mobile_money,card
# Public https address of the site (used for the return link after paying), e.g. https://pearlsculinarycounts.com
# APP_URL is already listed at the top of this file — set it there.

# -----------------------------------------------------------------------------
# Sailup SMS (Stage 8) — SERVER-SIDE ONLY. Without SAILUP_API_KEY the site works normally and
# each message is logged as "not sent" so nothing is lost; add the key and press Resend.
# -----------------------------------------------------------------------------
SAILUP_API_KEY=
# Your REGISTERED, APPROVED sender ID (brand name, max 11 letters/numbers). Register it first in the Sailup dashboard.
SAILUP_SENDER_ID=
# Shown once when you add the webhook in Sailup. Webhook URL: https://YOUR-DOMAIN/api/webhooks/sailup
SAILUP_WEBHOOK_SECRET=
# Optional: your own number (e.g. 0552471271) to get a text for every new paid order and enquiry.
SMS_OWNER_PHONE=

# -----------------------------------------------------------------------------
# Security & production (Stage 10)
# -----------------------------------------------------------------------------
# In production the server refuses to start if a required setting above is missing.
NODE_ENV=production
# report-only (default): the browser logs content-security-policy problems but blocks nothing.
# enforce: the browser blocks anything not on the allow-list. Switch after the README checklist passes.
CSP_MODE=report-only
# Optional: requests per IP per 15 minutes for the whole API (default 600).
API_RATE_LIMIT=600
